# ==============================================================================
# LegalAId - Root .gitignore
# ==============================================================================

# --- Environment Variables & Secrets (CRITICAL: NEVER COMMIT) ---
.env
.env.*
*.env
!.env.example
!*.env.example

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Python Testing & Coverage ---
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/

# --- Virtual Environments ---
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# --- Node & Frontend Build ---
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
*.tsbuildinfo
frontend/*.tsbuildinfo
.pnp
.pnp.js
.vitest/

# --- SQLite Databases & Local Vector Stores ---
*.db
*.db-shm
*.db-wal
*.db.bak
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal
backend/data/*.db.bak
backend/data/backups/
backend/data/vector_store/
backend/data/faiss_index.bin
backend/data/official_snapshots/

# --- Temporary & Local Backup Directories ---
cleanup_backup/
scratch/
.system_generated/
.gemini/
.antigravity/
.antigravity-ide/

# --- IDE & Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
