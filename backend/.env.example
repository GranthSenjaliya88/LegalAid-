# LegalAId Backend Environment Configuration Example

# Canonical SQLite Database Path
DATABASE_URL=sqlite:///./data/legalaid.db

# Optional Vector & RAG Search Settings
EMBEDDING_MODEL=models/text-embedding-004
FAISS_INDEX_PATH=./data/vector_store/faiss.index

# AI API Key (Gemini)
AI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.0-flash

# Logging & Environment
LOG_LEVEL=INFO
ENVIRONMENT=development

# CORS Policy — Allowed Frontend Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
