# LegalAId frontend environment.
# Copy to `.env` and adjust. NEVER put secret API keys here — this file is
# bundled into the client. Only the public backend base URL belongs here.

# Base URL for the backend API.
# Leave EMPTY in development to use the Vite dev proxy (same-origin /api).
# In production, set to your deployed backend origin, e.g. https://api.legalaid.example
VITE_API_BASE_URL=

# Optional: override the dev proxy target (defaults to http://127.0.0.1:8000)
VITE_PROXY_TARGET=http://127.0.0.1:8000
