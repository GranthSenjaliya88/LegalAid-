# ==============================================================================
# LegalAId - Master Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `.env` in the root and/or individual `backend/.env` and `frontend/.env`.
# NEVER commit your actual `.env` file containing secret keys to git.

# ------------------------------------------------------------------------------
# 1. Backend Server Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=dev_secret_key_change_me_in_production

# Canonical SQLite Database Path
DATABASE_URL=sqlite:///./data/legalaid.db

# ------------------------------------------------------------------------------
# 2. AI & Model Execution Settings
# ------------------------------------------------------------------------------
# Set to 'true' to run 100% locally and offline without external API calls
DISABLE_EXTERNAL_AI=true

# Optional: If DISABLE_EXTERNAL_AI is false, provide your Google Gemini API Key
AI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=gemini-2.0-flash

# Vector & Embedding Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_PATH=./data/faiss_index.bin

# ------------------------------------------------------------------------------
# 3. CORS & Networking Policy
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 4. Frontend Client Settings
# ------------------------------------------------------------------------------
# Leave EMPTY in development to use Vite's dev proxy (/api)
VITE_API_BASE_URL=
# Proxy target for Vite dev server
VITE_PROXY_TARGET=http://127.0.0.1:8000
